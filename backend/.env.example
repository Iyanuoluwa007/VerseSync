# VerseSync configuration template.
# Copy to backend/.env and fill in values. .env is gitignored -- never
# commit it, and never put a real key in this file.
#
#   Windows:  Copy-Item backend\.env.example backend\.env
#   macOS/Linux: cp backend/.env.example backend/.env
#
# Every value below is optional; VerseSync runs with all of them unset.
# A malformed value fails at startup with a message naming the variable,
# rather than silently falling back to a default.

# =====================================================================
# Core
# =====================================================================

# development | production
VERSESYNC_ENV=development

# Interface the API binds to.
#   127.0.0.1  loopback only (default, safest)
#   0.0.0.0    reachable on the LAN -- required if OBS runs on a
#              DIFFERENT machine to VerseSync. Only do this on a network
#              you trust: VerseSync has no authentication yet.
VERSESYNC_HOST=127.0.0.1
VERSESYNC_PORT=8000

# Translation used when a request does not name one.
VERSESYNC_DEFAULT_TRANSLATION=KJV

# =====================================================================
# CORS
# =====================================================================
# Only needed for a front end served from a DIFFERENT origin. The OBS
# Browser Source pointed at our own /projector page is same-origin and
# needs none of this.
# Comma-separated. Set to an empty value to disable CORS entirely.
VERSESYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# An OBS Browser Source pointed at a local .html FILE sends "Origin: null".
# Leave false unless you are using that workflow.
VERSESYNC_CORS_ALLOW_NULL_ORIGIN=false

# =====================================================================
# Projector overlay (OBS Browser Source)
# =====================================================================

# lowerthird | caption | fullscreen
PROJECTOR_THEME=lowerthird

# Seconds a verse stays on screen. 0 = leave it up until replaced.
PROJECTOR_HOLD_SECONDS=12

# Multiplier on all overlay text (0.3 - 4.0).
PROJECTOR_FONT_SCALE=1.0

# =====================================================================
# OBS WebSocket (optional)
# =====================================================================
# Lets a detected verse show/hide an OBS scene item or fill an OBS text
# source. NOT required for the Browser Source overlay.
# In OBS: Tools > WebSocket Server Settings.

OBS_WS_ENABLED=false
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_TIMEOUT=5

# The password OBS shows under "Show Connect Info". Leave blank if you
# disabled authentication in OBS.
OBS_WS_PASSWORD=

# Scene item toggled when a verse appears/clears. Both must be set for
# the toggle to happen; leave blank to skip it.
OBS_SCENE_NAME=
OBS_SCENE_ITEM=

# Optional OBS text source (GDI+ / FreeType) kept in sync with the
# current reference, e.g. "John 3:16 (KJV)". Leave blank to skip.
OBS_TEXT_SOURCE=

# =====================================================================
# LLM parser fallback (optional)
# =====================================================================
# Used only when the regex and Yoruba parsers both fail. Without a key
# the parser still works; it just loses the fallback tier.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# =====================================================================
# Speech to text (optional -- requires requirements-stt.txt)
# =====================================================================

# tiny | base | small | medium | large-v3
# medium is ~1.5 GB; large-v3 is markedly better for Yoruba.
STT_MODEL_SIZE=medium

# cuda | cpu
STT_DEVICE=cuda

# float16 (cuda) / int8 (cpu) / float32 (cpu, slower).
# Leave blank to auto-select from STT_DEVICE.
STT_COMPUTE_TYPE=

# Startup language. Switchable per session via POST /stt/language.
# en | yo | auto
STT_LANGUAGE=en

# Model used when the STT engine falls back to Groq's hosted Whisper.
# whisper-large-v3 | whisper-large-v3-turbo
STT_GROQ_MODEL=whisper-large-v3-turbo
