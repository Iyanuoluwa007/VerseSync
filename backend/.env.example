# VerseSync configuration template.
# Copy to .env and fill in values. .env is gitignored.

# Environment: development | production
VERSESYNC_ENV=development

# --- LLM provider (Phase 0 / Module 3) ---
# Required for the LLM fallback parser. Get a key at https://console.groq.com/keys
# Without a key, the parser still works on regex-only mode (~90-95% accuracy).
GROQ_API_KEY=

# Optional alternative LLM
# GEMINI_API_KEY=

# --- STT pipeline (Phase 0 / Module 4) ---
# Whisper model. tiny / base / small / medium / large-v3.
# medium = ~1.5GB, good English+Yoruba accuracy.
STT_MODEL_SIZE=medium

# Inference device. cuda / cpu / auto.
STT_DEVICE=cuda

# Compute type. float16 (cuda) / int8 (cpu) / float32 (cpu, slower).
# Leave blank to auto-select based on STT_DEVICE.
STT_COMPUTE_TYPE=

# Default language at startup. Switchable per session via /stt/language.
# en / yo / auto
STT_LANGUAGE=en

# --- Auth (Phase 0 / Module 5) ---
# These are written by the setup wizard, not edited by hand.
# ADMIN_PIN_HASH=
# JWT_SIGNING_KEY=
