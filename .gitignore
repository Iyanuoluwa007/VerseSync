# ---------------------------------------------------------------
# VerseSync data
# ---------------------------------------------------------------
# The SQLite database is generated by scripts/ingest_bibles.py (~30 MB).
*.db
*.db-journal
*.db-wal
*.db-shm

# Downloaded USFM Bible archives. These are fetched from eBible.org by
# scripts/download_bibles.py and are NOT redistributed from this repo --
# the Yoruba text is CC BY-SA 4.0 with a trademark requirement, so it
# travels from its source, not from here.
backend/data/bibles/*
!backend/data/bibles/.gitkeep

# Locally cached Whisper models (multiple GB).
models/
*.onnx
*.bin
*.ct2

# Captured audio, used when debugging the microphone path.
*.wav
*.flac

# ---------------------------------------------------------------
# Logs
